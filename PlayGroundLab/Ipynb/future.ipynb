   "metadata": {},
   "outputs": [],
   "source": [
    "# 没有 future import，会报错\n",
    "class A:\n",
    "    def f(self) -> B:   # 这里引用了还没定义的 B\n",
    "        return B()\n",
    "\n",
    "class B:\n",
    "    pass"
   ]
  }
