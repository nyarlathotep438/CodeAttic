import numpy as np
import matplotlib.pyplot as plt

# 图像尺寸
h, w = 600, 400
img = np.ones((h, w, 3))  # 先全白

# 定义颜色（注意：没有红色通道）
BLUE = np.array([0.1, 0.3, 0.9])   # 偏亮蓝
BLACK = np.array([0.0, 0.0, 0.0])
DARK_BLUE = np.array([0.05, 0.1, 0.4]
)
LIGHT_BLUE = np.array([0.6, 0.8, 1.0])

# 背景：大面积蓝色
img[:, :] = BLUE

# 罐子区域（中间一个圆柱）
cx, cy = w // 2, h // 2
radius_x, radius_y = 80, 200

for y in range(h):
    for x in range(w):
        # 椭圆形罐身
        dx = (x - cx) / radius_x
        dy = (y - cy) / radius_y
        if dx*dx + dy*dy <= 1.0:
            # 罐身基础颜色：深蓝，模拟“红色主体的阴影版”
            img[y, x] = DARK_BLUE

# 左右两侧做一点明暗变化，模拟立体感
for y in range(h):
    for x in range(w):
        dx = (x - cx) / radius_x
        dy = (y - cy) / radius_y
        if dx*dx + dy*dy <= 1.0:
            # 左侧更暗，右侧更亮
            if dx < 0:
                img[y, x] *= 0.7
            else:
                img[y, x] = img[y, x] * 0.5 + LIGHT_BLUE * 0.5

# 罐子顶部高光（白色椭圆）
top_h = cy - radius_y + 40
for y in range(top_h - 20, top_h + 20):
    for x in range(cx - 60, cx + 60):
        dx = (x - cx) / 60
        dy = (y - top_h) / 20
        if dx*dx + dy*dy <= 1.0:
            img[y, x] = np.array([1.0, 1.0, 1.0])

# 中间一条白色“波浪线”，暗示可口可乐 logo
for y in range(cy - 40, cy + 40):
    # 简单用一个正弦函数做波浪
    offset = int(20 * np.sin((y - cy) / 20))
    for x in range(cx - 10 + offset, cx + 10 + offset):
        dx = (x - (cx + offset)) / 10
        dy = (y - cy) / 40
        if dx*dx + dy*dy <= 1.0:
            img[y, x] = np.array([1.0, 1.0, 1.0])

# 显示并保存
plt.figure(figsize=(4, 6))
plt.imshow(img)
plt.axis('off')
plt.tight_layout()
plt.savefig("coke_illusion.png", dpi=200)
plt.show()

